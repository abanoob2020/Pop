# XCAMP Fitness OS - environment template (STAGING ONLY).
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# NEVER point these at production (xcamp_os). This layer is staging-only.

# --- Application (least-privilege) connection ---
FITNESS_DB_HOST=127.0.0.1
FITNESS_DB_PORT=5432
FITNESS_DB_NAME=xcamp_os_staging
FITNESS_DB_USER=xcamp_app
FITNESS_DB_PASSWORD=
# For Cloud SQL over TCP you will typically want:
# FITNESS_DB_SSLMODE=require

# Alternatively provide a full URL (overrides the parts above):
# FITNESS_DATABASE_URL=postgresql+psycopg://xcamp_app:***@127.0.0.1:5432/xcamp_os_staging

# --- Test-suite only (needs CREATE/DROP DATABASE privilege) ---
# Used by tests/conftest.py to build a throwaway migrated database.
FITNESS_TEST_ADMIN_URL=postgresql+psycopg://postgres@127.0.0.1:5432/postgres
FITNESS_TEST_DB_NAME=xcamp_os_test
